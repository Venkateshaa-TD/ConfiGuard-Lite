# Copy this file to .env and fill in real values. Never commit .env.
#
# Local filesystem paths (machine-specific; keep out of source code).
# Must point OUTSIDE this repository - run scripts/check_storage.py to
# verify each path is writable, has enough free space, and isn't
# accidentally inside the repo before storing anything real here.
CONFIGUARD_DATA_DIR=C:/path/to/datasets
CONFIGUARD_CHECKPOINT_DIR=C:/path/to/checkpoints
CONFIGUARD_CACHE_DIR=C:/path/to/cache
CONFIGUARD_OUTPUT_DIR=C:/path/to/outputs

# Device selection override: auto | cpu | cuda
CONFIGUARD_DEVICE=auto

# Optional override for the YuNet face detector ONNX model path.
# Default (if unset): <repo root>/models/face_detection/face_detection_yunet_2026may.onnx
# See docs/DATASETS.md for the model's source, license, and SHA-256.
# CONFIGUARD_YUNET_MODEL_PATH=C:/path/to/face_detection_yunet_2026may.onnx

# Pretrained backbone weight caches (Phase 4) - these are the *standard*
# env vars huggingface_hub/torch themselves read, not a configuard-
# specific name, so they're listed here for reference/documentation but
# must be set in the process environment (or loaded via
# configuard.env_loader.load_dotenv() before importing timm/torch) to
# actually take effect - see docs/ARCHITECTURE.md and docs/DECISIONS.md.
# Point all three OUTSIDE this repo and OUTSIDE the default
# C:\Users\<you>\.cache location, so a laptop-scale C: drive doesn't fill
# up with multi-GB model weight downloads.
HF_HOME=C:/path/to/cache/huggingface
HF_HUB_CACHE=C:/path/to/cache/huggingface/hub
TORCH_HOME=C:/path/to/cache/torch

# Logging
CONFIGUARD_LOG_LEVEL=INFO

# Phase 10 inference service (scripts/serve.py). Paths default to
# <CONFIGUARD_CHECKPOINT_DIR>/export/student_p80 and
# <CONFIGUARD_CHECKPOINT_DIR>/quality_gate/p80/quality_gate.json.
# CONFIGUARD_MODEL_PACKAGE_DIR=C:/path/to/checkpoints/export/student_p80
# CONFIGUARD_QUALITY_GATE_PATH=C:/path/to/checkpoints/quality_gate/p80/quality_gate.json
# Private directory for in-flight uploads (deleted after every request; default: <system temp>/configuard-uploads).
# CONFIGUARD_SERVICE_TEMP_DIR=C:/path/to/service-tmp
# Public origin of the website (optional). When set, page HTML carries absolute canonical/og:url/og:image
# URLs for link previews; when unset they stay relative. Never guessed by the app.
# CONFIGUARD_PUBLIC_BASE_URL=https://your-domain.example
# API keys (comma-separated). Plain keys are hashed at startup; 'sha256:<hex>' entries are used as-is.
# REQUIRED in production: the service refuses to start without them.
# CONFIGUARD_API_KEYS=sha256:<64 hex chars>
# The same list read from a file (Docker/Compose secret; one entry per line). Combined with the above.
# CONFIGUARD_API_KEYS_FILE=/run/secrets/configuard_api_keys
# Deployment toggles (true/false; override the YAML profile, e.g. in Docker):
# CONFIGUARD_UI_ENABLED=true
# CONFIGUARD_ALLOW_EXPLANATIONS=false
# CONFIGUARD_EXPLAIN_OCCLUSION_FALLBACK=false
# ONNX Runtime threads per analysis (0 = runtime default, sized to all host cores). Under a container CPU
# quota set it to cpus / max_concurrent_inference (compose.yaml: 2).
# CONFIGUARD_CPU_THREADS_PER_SESSION=2

# Optional: FFmpeg bin folder containing ffprobe. scripts/serve.py prepends it
# to PATH (useful when the shell's PATH predates the FFmpeg install).
# CONFIGUARD_FFMPEG_DIR=C:/path/to/ffmpeg/bin
