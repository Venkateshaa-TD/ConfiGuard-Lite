# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
*.egg

# --- Virtual environments ---
.venv/
venv/
env/

# --- Environment / secrets ---
.env
.env.*
!.env.example
*.pem
*.key
secrets.yaml
secrets.yml

# --- Datasets, checkpoints, models (never commit) ---
# NOTE: `dir/*` (not `dir/`) so the `!dir/.gitkeep` exceptions below can
# actually re-include the placeholder - git cannot re-include a file whose
# parent directory itself is excluded.
data/*
!data/.gitkeep
checkpoints/*
!checkpoints/.gitkeep
models/*
!models/.gitkeep
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
*.bin
*.h5

# --- Uploaded / user-submitted media (never commit) ---
# Anchored to the repo root (leading /) so this doesn't also match
# source packages named "media", e.g. src/configuard/media/, tests/media/.
/uploads/
/media/
*.mp4
*.avi
*.mov
*.mkv
*.jpg
*.jpeg
*.png
*.bmp
!docs/**/*.png
!docs/**/*.jpg

# --- Caches, generated outputs, reports ---
cache/*
!cache/.gitkeep
outputs/*
!outputs/.gitkeep
.cache/
*.log
logs/
runs/
wandb/
mlruns/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
*.report.json
*.report.html

# --- IDE / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Jupyter (exploration only, not source of truth) ---
.ipynb_checkpoints/

# React frontend (build output and tooling caches are never committed; package-lock.json is)
frontend/node_modules/
frontend/dist/
frontend/test-results/
frontend/playwright-report/
frontend/.vite/
